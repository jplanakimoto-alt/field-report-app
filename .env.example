# GEMINI_API_KEY: Optional (if AI text polish/summary is enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Neon PostgreSQL 設定
# ==========================================
# Neon Console (https://console.neon.tech) から取得した接続URL
# 例: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# ==========================================
# HStorage (写真ストレージ) 設定
# ==========================================
# HStorageのエンドポイントURL (REST APIまたはS3互換エンドポイント)
HSTORAGE_ENDPOINT=""

# HStorageのAPIキーまたはアクセストークン
HSTORAGE_API_KEY=""

# HStorageのバケット名またはプロジェクトID
HSTORAGE_BUCKET_ID=""

# 写真配信用公開ベースURL (任意: 省略時はエンドポイント直接配信)
HSTORAGE_PUBLIC_URL=""
